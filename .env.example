# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Oracle XE)
DB_USER=TRIP_USER
DB_PASSWORD=your_secure_password_here
DB_CONNECT_STRING=db:1521/XEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=10

# Docker Compose Environment Defaults
ORACLE_PASSWORD=your_oracle_sys_password_here
APP_USER=TRIP_USER
APP_USER_PASSWORD=your_app_user_password_here
